# ============================================================
#  Configuración de seguridad de npm
#  (después de los ataques a paquetes de npm de 2025 y 2026)
# ============================================================

# NO ejecutar scripts de instalación de las dependencias.
# Así se propagaban los gusanos tipo "Shai-Hulud": un paquete infectado
# corría código malicioso apenas hacías "npm install".
ignore-scripts=true

# Exigir la versión de Node que pide package.json (campo "engines").
# Si tienes una versión vieja, npm te avisa en vez de seguir.
engine-strict=true

# Guardar versiones exactas al agregar paquetes nuevos (sin ^ ni ~),
# para que nunca se instale "solita" una versión más nueva sin revisarla.
save-exact=true

# Avisar de vulnerabilidades conocidas al instalar.
audit=true
